{% extends 'base.html.twig' %}

{% block title %}
	{{product.name}}
{% endblock %}

{% block body %}
	<main class"container">
		<section class="row">
			<div class="col-12">
				<h1>{{product.name}}
				</h1>
			</div>
            <br><br>
            <div class="col-6">
           {%for image in product.images %}
            <img class="image" src="{{ asset('assets/public/image/{{product.image}}')}}" alt="">
            {% endfor %}
             </div>
            <div class="col-6">
                <p>{{product.description}}</p>
                <p>Prix : {{product.price}} €</p>
                <a href="{{path('cart_add', {id: product.id})}}" class="btn btn-success">Ajouter au panier</a>
            </div>
		</section>
	</main>


{% endblock %}
