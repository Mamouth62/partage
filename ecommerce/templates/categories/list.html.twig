{% extends 'base.html.twig' %}

{% block title %}
    {{ category.name }}
{% endblock %}

{% block body %}
    <main class="container">
        <section class="row">
            <div class="col-12">
                <h1>Liste des produits de {{ category.name }}</h1>
            </div>
            {% for product in category.products %}
                <div class="col-4 mb-4"> {# Utilisation de col-4 pour afficher 3 produits par ligne #}
                    <div class="card" style="width: 100%;">
                        {% set img = 'image/' ~ product.image %}
                        <a href="{{ path('products_details', {'slug': product.slug}) }}" class="btn btn-primary">
                            <img class="card-img-top" src="{{ asset(img) }}" alt="{{ product.name }}">
                        </a>
                        <div class="card-body">
                            <h5 class="card-title">{{ product.name }}</h5>
                            <p class="card-text">{{ product.price }}€</p>
                            <a href="{{ path('cart_add', {'id': product.id}) }}" class="btn btn-primary">
                                <i class="bi bi-cart"></i>
                            </a>
                        </div>
                    </div>
                </div>
                {% if loop.index % 3 == 0 and not loop.last %}
                    </section><section class="row">
                {% endif %}
            {% endfor %}
        </section>
    </main>
{% endblock %}

