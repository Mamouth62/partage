{% extends 'base.html.twig' %}

{% block title %}Résultats de la recherche
{% endblock %}

{% block body %}
	<h2 class="pb-5 text-center text-primary mt-4 pt-4">Résultats pour "{{ query }}"</h2>
	{% if products %}
		<ul>
			<div class="container py-2">
				<div class='row row-cols-1 row-cols-md-2 row-cols-lg-4'>
					{% for product in products %}
						<div class='col mb-4'>
							<div class="card h-100">

								{% set img = 'image/'~product.image %}
								<a href="{{path('products_details', {"slug": product.slug})}}" class"btn btn-primary"><img class="card-img-top" src="{{asset(img)}}">
									<a href="{{ path('products_details', {'slug': product.slug}) }}">
										{{ product.name }}
										<br><br>
										<p class="card-text">{{product.price}}€</p>
										<br>
										<a href="{{path('cart_add', {id: product.id})}}" class="btn btn-primary">Ajouter au panier
											<i class="bi bi-cart"></i>
										</a>
									</a>
								</div>
							</div>
						</div>
					</div>
				</ul>
			{% endfor %}
		{% endif %}
	{% endblock %}
