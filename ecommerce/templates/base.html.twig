<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
		<title>
		
			{% block title %}
			Foot2Street
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% block stylesheets %}
			<link href="https://bootswatch.com/5/lux/bootstrap.min.css" rel="stylesheet">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
		{% endblock %}
		<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{path('app_accueil')}}"> Accueil</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarColor01">
					<ul class="navbar-nav me-auto">
						{% if not
	is_granted('IS_AUTHENTICATED_FULLY') %}
							<li class="nav-item">
								<a class="nav-link" href="{{path('app_login')}}">Se connecter
								</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{path('app_register')}}">S'inscrire
								</a>
							</li>
						{% else %}
							<li class="nav-item">
								<a class="nav-link" href="{{path('app_logout')}}">
									{{app.user.email}}
									<i class="bi
																																																					bi-x-circle-fill"></i>
								</a>
							</li>
						{% endif %}
						<a class="nav-link" href="/ecommerce/categories/nations">Nations</a>
						<li class="nav-item"></li>
						<li class="nav-item dropdown">
							<a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">Championnat</a>
							<div class="dropdown-menu">
								<a class="dropdown-item" href="/ecommerce/categories/ligue1">Ligue 1</a>
								<a class="dropdown-item" href="/ecommerce/categories/pl">Premier League</a>
								<a class="dropdown-item" href="/ecommerce/categories/bundesliga">Bundesliga</a>
								<a class="dropdown-item" href="/ecommerce/categories/liga">Liga</a>
								<a class="dropdown-item" href="/ecommerce/categories/seriea">Serie A</a>
							</li>
						</li>
					</ul>
					<form class="d-flex" action="{{path('app_search')}}" method="get">
						<input class="form-control me-sm-2" type="search" name="q" placeholder="Recherche">
						<button class="Rechercher" type="submit">Rechercher</button>
					</form>
				</div>
			</div>
			<li class="nav-item">
				<a class="nav-item" href="{{path('cart_index')}}"><i class="bi bi-cart"></i></a>
			</li>
			</div>
	</head>
