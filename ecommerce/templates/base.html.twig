<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		{% block stylesheets %}
			<link href="https://bootswatch.com/5/lux/bootstrap.min.css" rel="stylesheet">
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
		{% endblock %}
		<nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
			<div class="container-fluid">
				<a class="navbar-brand" href="{{path('app_accueil')}}">Accueil</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarColor01">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link active" href="/ecommerce/categories/ligue1">Ligue 1
								<span class="visually-hidden">(current)</span>
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/ecommerce/categories/pl">Premier League</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/ecommerce/categories/bundesliga">Bundesliga</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/ecommerce/categories/liga">Liga</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/ecommerce/categories/seriea">Série A</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="/ecommerce/categories/nations">Nations</a>
						</li>		
							</div>
						</li>
					</ul>
					<form class="d-flex">
						<input class="form-control me-sm-2" type="search" placeholder="Search">
						<button class="btn btn-secondary my-2 my-sm-0" type="submit">Search</button>
					</form>
					<li class="nav-item">
						<ul class="navbar-nav me-auto">
							{% if not
is_granted('IS_AUTHENTICATED_FULLY') %}
								<li class="nav-item">
									<a class="nav-link" href="{{path('app_login')}}">Se connecter
									</a>
								</li>
								<li class="nav-item">
									<a class="nav-link" href="{{path('app_register')}}">S'inscrire
									</a>
								</li>
							{% else %}
								<li class="nav-item">
									<a class="nav-link" href="{{path('app_logout')}}">
										{{app.user.email}}
										<i class="bi
											bi-x-circle-fill"></i>
									</a>
								</li>
							{% endif %}
						</div>
					</li>
				</div>
				<li class="nav-item">
							<a class="nav-link" href="{{path('cart_index')}}">Panier</a>
						</li>	
			</nav>
			{% block javascripts %}{% endblock %}
		</head>
		<body>
			{% block body %}{% endblock %}
			<br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br>
			{% include 'base/footer.html.twig'%}</body>
	</head>
</html>
