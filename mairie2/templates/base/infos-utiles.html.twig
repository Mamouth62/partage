							<h2 class="h4">A Venir</h2><br>
							<a href="#" class="btn btn-dark-blue">Voir</a>
						</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card">
						<div class="card-body">
							<h2 class="h4">A Venir</h2><br>
							<a href="#" class="btn btn-dark-blue">Voir</a>
						</div>
					</div>
				</div>
			</div>
			<div class="container mt-5 text-center">
				<a href="{{ path('app_vie_pratique') }}" class="btn btn-dark-blue mb-4">Retour à la Page Vie Pratique</a>
			</div>
		</div><br><br>
	</div>
{% endblock %}
